{
  "name": "acores-central",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "start": "node --no-warnings=ExperimentalWarning server/index.js",
    "dev": "concurrently -k -n api,web -c cyan,magenta \"node --no-warnings=ExperimentalWarning server/index.js\" \"vite --host 127.0.0.1\"",
    "server": "node --no-warnings=ExperimentalWarning server/index.js",
    "start:supervised": "node scripts/supervise.mjs",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "lint": "eslint .",
    "test": "node --no-warnings=ExperimentalWarning --test tests/*.test.mjs",
    "security:scan": "node scripts/security-scan.mjs",
    "security:admin": "node --no-warnings=ExperimentalWarning scripts/admin.mjs",
    "backup": "node --no-warnings=ExperimentalWarning scripts/backup.mjs",
    "migrate:postgres": "node --no-warnings=ExperimentalWarning scripts/migrate-sqlite-to-postgres.mjs",
    "package:vercel": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-vercel.ps1"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.0.4",
    "@whiskeysockets/baileys": "^7.0.0-rc.9",
    "bcryptjs": "3.0.3",
    "concurrently": "^9.2.1",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "express-rate-limit": "8.7.0",
    "helmet": "8.3.0",
    "lucide-react": "^0.544.0",
    "pg": "^8.16.3",
    "pino": "^10.3.1",
    "qrcode": "^1.5.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-markdown": "10.1.0",
    "vite": "^7.1.7",
    "ws": "^8.18.3",
    "zod": "4.6.2"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.10.0",
    "globals": "17.12.0"
  }
}
