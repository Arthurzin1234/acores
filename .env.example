NODE_ENV=development
APP_ORIGIN=http://127.0.0.1:5173
PORT=3333
# Vercel static panel: keep these empty when Vercel rewrites /api and /ws.
VITE_API_URL=
VITE_WS_URL=
# Render: use render.yaml, automatic HTTPS origin, and TRUST_PROXY=1.
# Local TLS proxy only: APP_ORIGIN=https://your-domain and TRUST_PROXY=loopback.
TRUST_PROXY=
AI_PROVIDER=
OPENAI_API_KEY=
GEMINI_API_KEY=
OPENAI_MODEL=
GEMINI_MODEL=
GROK_API_KEY=
GROK_MODEL=grok-3-mini
# Empty database only. Never resets an existing password.
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
BIND_HOST=127.0.0.1
PERSISTENT_ROOT=
# Optional: absolute private location outside the web root.
DATA_DIR=
ENABLE_SIMULATOR=false
SEED_DEMO=false
WHATSAPP_AUTOSTART=true
# Bounded recovery and health checks (milliseconds).
WHATSAPP_AUTH_DIR=
WHATSAPP_MAX_RECONNECTS=6
PROCESS_MAX_RESTARTS=6
AI_TIMEOUT_MS=12000
AI_HEALTH_INTERVAL_MS=300000
HEALTH_INTERVAL_MS=30000
WHATSAPP_OFFLINE_ALERT_MS=120000
QUEUE_ALERT_LIMIT=20
MEMORY_ALERT_MB=512
# Optional HTTPS endpoint for operational alerts only; never customer content.
ADMIN_ALERT_WEBHOOK_URL=
BACKUP_ENCRYPTION_KEY=
BACKUP_DIR=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=
# When this is set, the Node backend uses Supabase PostgreSQL as its source of truth.
# Keep the direct database URL server-only; never expose it as VITE_* or in the browser.
PG_POOL_MAX=5
PG_SSL=true
# Stable 32-byte base64 key used to encrypt AI keys stored in ai_settings.
AI_ENCRYPTION_KEY=
# Optional separate key for Baileys credentials stored in Supabase. If empty,
# the server derives a stable key from SUPABASE_DB_URL without exposing it.
WHATSAPP_AUTH_ENCRYPTION_KEY=
